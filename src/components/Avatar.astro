---
import { ACHIEVEMENT_IDS } from '../scripts/game';
import { useDict, fmt } from '../i18n';
import type { Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  /** Idioma de los textos del panel, los avisos y lo que dice el avatar. */
  lang: Lang;
  /** Proyecto cuyo marco de fotos pone el avatar sobre su escritorio (en la página de un proyecto). */
  frame?: string;
}
const { frame, lang } = Astro.props;
const g = useDict(lang).game;
const total = ACHIEVEMENT_IDS.length;
---
<div class="avatar" data-state="hero" data-frame={frame}>
  <div class="bubble" id="avatar-bubble" aria-hidden="true"></div>
  <div class="panel" id="avatar-panel" role="dialog" aria-label={g.panelAria} hidden>
    <p class="panel-title">{g.panelTitle} <span id="avatar-score"></span></p>
    <ul>
      {
        ACHIEVEMENT_IDS.map((id) => (
          <li data-id={id}>
            <span class="check" aria-hidden="true"></span>
            <span class="text">
              <b>???</b>
              <small>{g.toDiscover}</small>
            </span>
            <button type="button" class="try" aria-label={fmt(g.repeatAria, { title: g.achievements[id].title })}>{g.repeat}</button>
          </li>
        ))
      }
    </ul>
    <p class="done" hidden>
      {g.done} <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </div>
  <button class="counter" id="avatar-counter" type="button" aria-expanded="false" aria-controls="avatar-panel">
    <span class="dot" aria-hidden="true"></span><span id="avatar-count">0/{total}</span>
  </button>
  <button class="stage" id="avatar-stage" type="button" aria-label={g.stageAria}>
    <canvas id="avatar-canvas" width="1024" height="1024" aria-hidden="true"></canvas>
  </button>
</div>
<div class="toast" id="avatar-toast" role="status" aria-live="polite"></div>
<script type="application/json" id="avatar-i18n" set:html={JSON.stringify(g)} />

<script>
  import { startAvatar } from '../scripts/avatar';
  import { ACHIEVEMENT_IDS, WORDS, enableWordDrag, loadUnlocked, saveUnlocked } from '../scripts/game';
  import type { AchievementId } from '../scripts/game';
  import type { Dict } from '../i18n/types';

  // Los textos (en el idioma de la página) los pone el servidor en un JSON; aquí solo se rellenan sus huecos.
  const g: Dict['game'] = JSON.parse(document.getElementById('avatar-i18n')!.textContent!);
  const fmt = (tpl: string, vars: Record<string, string | number>) => tpl.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const root = document.querySelector<HTMLElement>('.avatar')!;
  const canvas = $<HTMLCanvasElement>('avatar-canvas');
  const bubble = $('avatar-bubble');
  const stage = $('avatar-stage');
  const counter = $('avatar-counter');
  const panel = $('avatar-panel');
  const toast = $('avatar-toast');
  const total = ACHIEVEMENT_IDS.length;
  const unlocked = loadUnlocked();

  const render = () => {
    const n = ACHIEVEMENT_IDS.filter((id) => unlocked.has(id)).length;
    $('avatar-count').textContent = `${n}/${total}`;
    $('avatar-score').textContent = `${n}/${total}`;
    counter.toggleAttribute('data-new', n === 0);
    counter.classList.toggle('complete', n === total);
    counter.setAttribute('aria-label', fmt(g.counterAria, { n, total }));
    panel.querySelectorAll<HTMLElement>('li').forEach((li) => {
      const id = li.dataset.id as AchievementId;
      const a = g.achievements[id];
      const on = unlocked.has(id);
      li.classList.toggle('on', on);
      li.querySelector('b')!.textContent = on ? a.title : '???';
      li.querySelector('small')!.textContent = on ? a.how : g.toDiscover;
    });
    panel.querySelector<HTMLElement>('.done')!.hidden = n < total;
  };
  render();

  startAvatar(canvas, bubble, root.dataset.frame).then((avatar) => {
    if (!avatar) return;
    let toastTimer: number | undefined;

    const announce = (text: string) => {
      toast.textContent = text;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('show'), 3800);
    };

    /** Reacciona y, si es la primera vez, desbloquea. Devuelve si era nuevo. */
    // En la página de un proyecto: pone su marco de fotos sobre el escritorio.
    if (root.dataset.frame) {
      setTimeout(() => {
        avatar.placeFrame();
        avatar.react('marco', '', 1100);
      }, 700);
    }

    // En móvil, al bajar por la página el avatar se agacha (solo asoma la cabeza) para no tapar el texto; al subir o tocarlo vuelve.
    const mobile = matchMedia('(max-width: 999px)');
    let lastY = scrollY;
    addEventListener(
      'scroll',
      () => {
        const y = scrollY;
        if (mobile.matches) {
          if (y > lastY + 6 && y > 120) root.classList.add('tucked');
          else if (y < lastY - 6) root.classList.remove('tucked');
        }
        lastY = y;
      },
      { passive: true },
    );
    stage.addEventListener('click', () => root.classList.remove('tucked'));

    const trigger = (id: AchievementId, ms = 3200) => {
      const a = g.achievements[id];
      const isNew = !unlocked.has(id);
      if (isNew) {
        unlocked.add(id);
        saveUnlocked(unlocked);
        render();
        root.classList.remove('burst');
        void root.offsetWidth;
        root.classList.add('burst');
        const n = unlocked.size;
        announce(n === total ? g.complete : fmt(g.unlocked, { title: a.title, n, total }));
      }
      avatar.react(id, a.say, id === 'sueno' ? 0 : ms);
      return isNew;
    };

    // Clic: el primero es el saludo; muchos seguidos, mareo; el resto, un chiste.
    const clicks: number[] = [];
    stage.addEventListener('click', () => {
      const now = performance.now();
      clicks.push(now);
      while (clicks.length && now - clicks[0] > 2500) clicks.shift();
      if (clicks.length >= 5) {
        clicks.length = 0;
        trigger('mareo');
      } else if (!unlocked.has('hola')) trigger('hola');
      else avatar.react('asiente', g.jokes[Math.floor(Math.random() * g.jokes.length)], 2600);
    });

    // Arrastrar palabras hasta el avatar.
    enableWordDrag({
      target: () => stage,
      onOver: (over) => root.classList.toggle('over', over),
      onDrop: (word) => {
        const w = WORDS[word];
        if (!w) return;
        if (w.achievement) trigger(w.achievement);
        else avatar.react('asiente', g.words[word] ?? '', 3000);
      },
    });

    // Quedarse quieto: se duerme; al volver a moverte, se despierta.
    let lastActive = performance.now();
    let asleep = false;
    const active = () => {
      lastActive = performance.now();
      if (asleep) {
        asleep = false;
        avatar.stop();
        avatar.say(g.woke, 2200);
      }
    };
    for (const ev of ['pointermove', 'pointerdown', 'keydown', 'scroll', 'touchstart'])
      addEventListener(ev, active, { passive: true });
    setInterval(() => {
      if (!asleep && !document.hidden && performance.now() - lastActive > 25000) {
        asleep = true;
        trigger('sueno');
      }
    }, 2000);

    // Llegar al final de la página (habiendo bajado de verdad).
    addEventListener(
      'scroll',
      () => {
        const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
        if (atBottom && scrollY > 200 && !unlocked.has('final')) trigger('final', 4500);
      },
      { passive: true },
    );

    // Cambiar de tema varias veces seguidas.
    const themeTaps: number[] = [];
    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.theme, .theme-group button')) return;
      const now = performance.now();
      themeTaps.push(now);
      while (themeTaps.length && now - themeTaps[0] > 8000) themeTaps.shift();
      if (themeTaps.length >= 4 && !unlocked.has('tema')) trigger('tema');
    });

    // Agitar el móvil (en iOS el navegador pide permiso: se pide con el primer toque al avatar).
    const touchDevice = matchMedia('(pointer: coarse)').matches;
    let lastShake = 0;
    let shakes = 0;
    let [lx, ly, lz] = [0, 0, 0];
    const onMotion = (e: DeviceMotionEvent) => {
      const a = e.accelerationIncludingGravity;
      if (!a || a.x == null || a.y == null || a.z == null) return;
      const delta = Math.abs(a.x - lx) + Math.abs(a.y - ly) + Math.abs(a.z - lz);
      [lx, ly, lz] = [a.x, a.y, a.z];
      const now = performance.now();
      if (delta < 25 || now - lastShake < 120) return;
      shakes = now - lastShake > 900 ? 1 : shakes + 1;
      lastShake = now;
      if (shakes >= 4) {
        shakes = 0;
        trigger('agitar');
      }
    };
    if (touchDevice && typeof DeviceMotionEvent !== 'undefined') {
      const ask = (DeviceMotionEvent as unknown as { requestPermission?: () => Promise<string> }).requestPermission;
      if (typeof ask !== 'function') addEventListener('devicemotion', onMotion);
      else
        stage.addEventListener(
          'click',
          () => {
            ask.call(DeviceMotionEvent)
              .then((r) => r === 'granted' && addEventListener('devicemotion', onMotion))
              .catch(() => {});
          },
          { once: true },
        );
    }

    // Código clásico con el teclado.
    const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let typed = 0;
    addEventListener('keydown', (e) => {
      const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
      typed = k === code[typed] ? typed + 1 : k === code[0] ? 1 : 0;
      if (typed === code.length) {
        typed = 0;
        trigger('konami');
      }
    });

    // Panel: lista de interacciones; las ya descubiertas se pueden repetir.
    const setPanel = (open: boolean) => {
      panel.hidden = !open;
      counter.setAttribute('aria-expanded', String(open));
    };
    counter.addEventListener('click', (e) => {
      e.stopPropagation();
      setPanel(panel.hidden === true);
    });
    panel.addEventListener('click', (e) => {
      const li = (e.target as Element).closest<HTMLElement>('li');
      if (li && (e.target as Element).closest('.try')) trigger(li.dataset.id as AchievementId);
    });
    addEventListener('click', (e) => {
      if (!panel.hidden && !root.contains(e.target as Node)) setPanel(false);
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setPanel(false);
        counter.focus();
      }
    });
  });
</script>

<style>
  .avatar {
    --size: 128px;
    --ease: cubic-bezier(0.19, 1, 0.22, 1);
    position: fixed;
    z-index: 45;
    right: clamp(10px, 2.6vw, 38px);
    bottom: calc(10px + env(safe-area-inset-bottom, 0px));
    width: var(--size);
    opacity: 0;
    transition:
      opacity 0.8s ease 0.6s,
      translate 1s var(--ease) 0.6s;
  }
  @media (min-width: 1000px) {
    .avatar {
      --size: 210px;
    }
  }
  .avatar:global(.ready) {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .avatar {
      translate: 0 40px;
    }
    .avatar:global(.ready) {
      translate: 0 0;
    }
  }

  @media (max-width: 999px) {
    /* Al bajar por la página, el avatar se agacha y solo asoma la cabeza por el borde de abajo. */
    .avatar {
      transition:
        opacity 0.8s ease 0.6s,
        translate 1s var(--ease) 0.6s,
        transform 0.45s var(--ease);
    }
    .avatar:global(.tucked) {
      transform: translateY(46%);
    }
  }

  .stage {
    appearance: none;
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: transform 0.5s var(--ease);
    -webkit-tap-highlight-color: transparent;
  }
  .stage:hover {
    transform: translateY(-3px) scale(1.03);
  }
  .stage:active {
    transform: scale(0.97);
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.22));
  }
  /* Zona de suelta: aparece al empezar a arrastrar una palabra y se enciende al acercarla. */
  .stage::before {
    content: '';
    position: absolute;
    inset: -6px;
    border: 1.5px dashed var(--accent);
    border-radius: 28px;
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity 0.25s ease,
      transform 0.4s var(--ease),
      background-color 0.25s ease;
    pointer-events: none;
  }
  :global(body.is-dragging) .stage::before {
    opacity: 0.55;
    transform: none;
  }
  .avatar:global(.over) .stage::before {
    opacity: 1;
    transform: scale(1.04);
    background: rgba(var(--glow), 0.16);
  }
  .stage:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 4px;
    border-radius: 20px;
  }

  /* Al desbloquear algo: un anillo que se expande. */
  .avatar::after {
    content: '';
    position: absolute;
    inset: 8%;
    border: 2px solid var(--accent);
    border-radius: 30px;
    opacity: 0;
    pointer-events: none;
  }
  .avatar:global(.burst)::after {
    animation: ping 0.9s var(--ease);
  }
  @keyframes ping {
    from {
      opacity: 0.9;
      transform: scale(0.8);
    }
    to {
      opacity: 0;
      transform: scale(1.35);
    }
  }

  .counter {
    appearance: none;
    position: absolute;
    z-index: 2;
    top: 2px;
    right: 2px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 10px;
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    background: var(--glass-bg);
    color: var(--text);
    font: 500 11px/1 var(--font);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: 0 4px 14px var(--glass-shadow);
    opacity: 0.75;
    transition:
      opacity 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease,
      transform 0.4s var(--ease);
  }
  .avatar:hover .counter,
  .counter:focus-visible,
  .counter[aria-expanded='true'] {
    opacity: 1;
  }
  .counter:hover {
    transform: translateY(-1px);
  }
  .counter.complete {
    background: var(--accent);
    color: var(--on-accent);
    border-color: var(--accent);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .counter.complete .dot {
    background: var(--on-accent);
  }
  .counter:not([data-new]) .dot {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .counter[data-new] .dot {
      animation: breathe 2.2s ease-in-out infinite;
    }
    @keyframes breathe {
      0%,
      100% {
        box-shadow: 0 0 0 0 rgba(var(--glow), 0.6);
      }
      50% {
        box-shadow: 0 0 0 6px rgba(var(--glow), 0);
      }
    }
  }

  .bubble {
    position: absolute;
    z-index: 1;
    right: calc(100% - 14px);
    bottom: 42%;
    width: max-content;
    max-width: min(230px, 56vw);
    padding: 9px 13px;
    border: 1px solid var(--glass-line);
    border-radius: 14px 14px 4px 14px;
    background: var(--accent);
    color: var(--on-accent);
    font: 500 13px/1.35 var(--font);
    box-shadow: 0 8px 24px var(--glass-shadow);
    opacity: 0;
    transform: translateY(6px) scale(0.96);
    transform-origin: bottom right;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.4s var(--ease);
  }
  .bubble:global(.show) {
    opacity: 1;
    transform: none;
  }

  .panel {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: calc(100% + 10px);
    width: min(330px, calc(100vw - 20px));
    padding: 16px;
    border: 1px solid var(--glass-line);
    border-radius: 18px;
    background: var(--glass-bg);
    color: var(--text);
    backdrop-filter: blur(28px) saturate(1.6);
    box-shadow: 0 16px 48px var(--glass-shadow);
  }
  .panel:not([hidden]) {
    animation: pop 0.4s var(--ease);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
    }
  }
  .panel-title {
    display: flex;
    justify-content: space-between;
    margin: 0 0 10px;
    font: 500 11px/1 var(--font);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 0;
    border-top: 1px solid var(--line);
  }
  .check {
    flex: none;
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--line);
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }
  li:global(.on) .check {
    background: var(--accent);
    border-color: var(--accent);
  }
  li:global(.on) .check::after {
    content: '';
    width: 4px;
    height: 8px;
    margin-top: -2px;
    border: solid var(--on-accent);
    border-width: 0 1.6px 1.6px 0;
    transform: rotate(40deg);
  }
  .text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .text b {
    font: 600 13px/1.2 var(--font);
  }
  .text small {
    font: 400 12px/1.3 var(--font);
    color: var(--muted);
  }
  li:global(.on) .text b {
    color: var(--accent-text);
  }
  li:not(:global(.on)) .try {
    display: none;
  }
  .try {
    appearance: none;
    flex: none;
    padding: 5px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: 500 11px/1 var(--font);
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .try:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .done {
    margin: 12px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font: 500 13px/1.4 var(--font);
  }
  .done a {
    color: var(--accent-text);
  }

  /* Aviso de logro: abajo y centrado (fuera del contenedor del avatar, que lleva `translate`). */
  .toast {
    position: fixed;
    z-index: 70;
    left: 50%;
    bottom: calc(22px + env(safe-area-inset-bottom, 0px));
    padding: 11px 18px;
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    background: var(--glass-bg);
    color: var(--text);
    font: 500 13px/1.2 var(--font);
    letter-spacing: 0.02em;
    backdrop-filter: blur(24px) saturate(1.6);
    box-shadow: 0 10px 34px var(--glass-shadow);
    opacity: 0;
    transform: translate(-50%, 14px);
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.5s var(--ease);
  }
  .toast:global(.show) {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar,
    .stage,
    .bubble,
    .toast {
      transition: none;
    }
  }
</style>
