---
import { BONUS_IDS, HINT_META, REQUIRED_IDS } from '../scripts/game';
import { useDict, fmt } from '../i18n';
import type { Lang } from '../i18n';
import { site, getProjects } from '../data/site';

interface Props {
  /** Idioma de los textos del panel, los avisos y lo que dice el avatar. */
  lang: Lang;
  /** Proyecto cuyo marco de fotos pone el avatar sobre su escritorio (en la página de un proyecto). */
  frame?: string;
}
const { frame, lang } = Astro.props;
const g = useDict(lang).game;
const total = REQUIRED_IDS.length;
---
<div class="avatar" data-state="hero" data-frame={frame} data-slugs={getProjects(lang).map((p) => p.slug).join(',')}>
  <div class="bubble" id="avatar-bubble" aria-hidden="true"></div>
  <div class="panel" id="avatar-panel" role="dialog" aria-label={g.panelAria} hidden>
    <p class="panel-title">{g.panelTitle} <span id="avatar-score"></span></p>
    <ul>
      {
        [...REQUIRED_IDS, null, ...BONUS_IDS].map((id) => id === null ? (
          <li class="extras-title">{g.extras}</li>
        ) : (
          <li data-id={id}>
            <span class="check" aria-hidden="true"></span>
            <span class="text">
              <b>???</b>
              <small>{g.toDiscover}</small>
              <span class="tags">
                <span class="tag">{g.categories[HINT_META[id].category]}</span>
                {HINT_META[id].device && <span class="tag dev">{g.devices[HINT_META[id].device!]}</span>}
              </span>
            </span>
            <button type="button" class="hint" aria-label={g.hintAria}>{g.hint}</button>
            <button type="button" class="try" aria-label={fmt(g.repeatAria, { title: g.achievements[id].title })}>{g.repeat}</button>
          </li>
        ))
      }
    </ul>
    <p class="done" hidden>
      {g.done} <a href={`mailto:${site.email}`}>{site.email}</a>
      <button type="button" class="skin" id="avatar-skin"></button>
    </p>
  </div>
  <button class="counter" id="avatar-counter" type="button" aria-expanded="false" aria-controls="avatar-panel">
    <span class="dot" aria-hidden="true"></span><span id="avatar-count">0/{total}</span>
  </button>
  <button class="stage" id="avatar-stage" type="button" aria-label={g.stageAria}>
    <canvas id="avatar-canvas" width="1024" height="1024" aria-hidden="true"></canvas>
  </button>
</div>
<div class="toast" id="avatar-toast" role="status" aria-live="polite"></div>
<script type="application/json" id="avatar-i18n" set:html={JSON.stringify(g)} />

<script>
  import { startAvatar } from '../scripts/avatar';
  import { ACHIEVEMENT_IDS, HINT_META, REQUIRED_IDS, SECRETS, WORDS, addPending, enableWordDrag, loadHints, loadUnlocked, saveHints, saveUnlocked, takePending } from '../scripts/game';
  import type { AchievementId } from '../scripts/game';
  import type { Dict } from '../i18n/types';

  // Los textos (en el idioma de la página) los pone el servidor en un JSON; aquí solo se rellenan sus huecos.
  const g: Dict['game'] = JSON.parse(document.getElementById('avatar-i18n')!.textContent!);
  const fmt = (tpl: string, vars: Record<string, string | number>) => tpl.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const root = document.querySelector<HTMLElement>('.avatar')!;
  const canvas = $<HTMLCanvasElement>('avatar-canvas');
  const bubble = $('avatar-bubble');
  const stage = $('avatar-stage');
  const counter = $('avatar-counter');
  const panel = $('avatar-panel');
  const toast = $('avatar-toast');
  // Lo que se puede conseguir depende del dispositivo: agitar solo en móvil; teclado, ventana y herramientas solo en
  // ordenador. Lo que este dispositivo no puede hacer pasa a extra (si hubiera forma, se desbloquea igual) y no cuenta
  // para el total ni para «completista»: así se puede completar la colección en el móvil y en el PC.
  const mobileDevice = matchMedia('(pointer: coarse)').matches;
  const requiredIds = REQUIRED_IDS.filter((id) => {
    const d = HINT_META[id].device;
    return !d || d === (mobileDevice ? 'mobile' : 'desktop');
  });
  const BONUS_IDS = ACHIEVEMENT_IDS.filter((id) => !requiredIds.includes(id));
  const total = requiredIds.length;
  // En el panel, esos pasan debajo del rótulo de extras.
  for (const id of REQUIRED_IDS.filter((x) => !requiredIds.includes(x)))
    panel.querySelector('ul')!.append(panel.querySelector(`li[data-id="${id}"]`)!);
  const unlocked = loadUnlocked();
  const hints = loadHints();

  const render = () => {
    const n = requiredIds.filter((id) => unlocked.has(id)).length;
    $('avatar-count').textContent = `${n}/${total}`;
    $('avatar-score').textContent = `${n}/${total}`;
    counter.toggleAttribute('data-new', n === 0);
    counter.classList.toggle('complete', n === total);
    counter.setAttribute('aria-label', fmt(g.counterAria, { n, total }));
    panel.querySelectorAll<HTMLElement>('li[data-id]').forEach((li) => {
      const id = li.dataset.id as AchievementId;
      const a = g.achievements[id];
      const on = unlocked.has(id);
      li.classList.toggle('on', on);
      li.querySelector('b')!.textContent = on ? a.title : '???';
      const level = hints[id] ?? 0;
      li.querySelector('small')!.textContent = on ? a.how : level >= 2 ? a.tip : level === 1 ? a.riddle : g.toDiscover;
      li.dataset.hint = on ? '' : String(level);
      const btn = li.querySelector<HTMLButtonElement>('.hint')!;
      btn.hidden = on || level >= 2;
      btn.textContent = level === 0 ? g.hint : g.hintMore;
    });
    panel.querySelector<HTMLElement>('.done')!.hidden = n < total;
  };
  render();

  // En pantallas muy anchas (portada): el avatar empieza grande, en el hueco `.avatar-slot` a la derecha de la ficha,
  // y al desplazarse se encoge y baja a su esquina. Todo con dos variables del propio avatar: su tamaño (`--size`) y un
  // desplazamiento desde su esquina; el bocadillo, el contador y el panel van con él. En móvil y portátiles, nada de esto.
  const slot = document.querySelector<HTMLElement>('.avatar-slot');
  const wide = matchMedia('(min-width: 1360px)');
  const SMALL = 210; // el tamaño de siempre en escritorio (ver `--size` abajo)
  let docked = 0; // desplazamiento (px) al que el avatar ya ha llegado a su esquina
  let roof = 0; // el borde de abajo del hueco (en la página) menos lo que mide la cinta de arriba: tope de altura del avatar
  let frame = 0;
  const place = () => {
    frame = 0;
    if (!slot || !wide.matches) {
      root.style.removeProperty('--size');
      root.style.transform = '';
      return;
    }
    const w = document.documentElement.clientWidth;
    const h = document.documentElement.clientHeight;
    const cs = getComputedStyle(root);
    const R = w - parseFloat(cs.right);
    const B = h - parseFloat(cs.bottom);
    const r = slot.getBoundingClientRect();
    // Entra en el hueco (sin pisar la ficha) y sin subir hasta la cinta de arriba (el contador va en su esquina).
    const big = Math.min(460, roof, Math.max(270, r.width * 1.1));
    const k = Math.min(1, Math.max(0, scrollY / docked));
    const smooth = (v: number) => v * v * (3 - 2 * v);
    const t = smooth(k); // arranque y llegada suaves
    // Primero baja y luego va hacia la derecha: así no cruza la ficha de «De un vistazo».
    const ty = smooth(Math.min(1, k * 1.5));
    const tx = smooth(Math.max(0, (k - 0.25) / 0.75));
    const x = r.right; // pegado al borde derecho de la columna
    const y = r.bottom;
    root.style.setProperty('--size', `${big + (SMALL - big) * t}px`);
    root.style.transform = `translate(${x + (R - x) * tx - R}px, ${y + (B - y) * ty - B}px)`;
  };
  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(place);
  };
  if (slot) {
    const measure = () => {
      const r = slot.getBoundingClientRect();
      docked = Math.max(240, r.top + scrollY);
      roof = r.bottom + scrollY - 372;
      schedule();
    };
    measure();
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', measure);
    wide.addEventListener('change', measure);
    document.fonts?.ready.then(measure);
  }

  // El avatar (20 imágenes y un lienzo de 1024 px) arranca cuando el navegador está libre: no compite con el primer pintado.
  const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1500 }) : setTimeout(fn, 300));
  idle(() => startAvatar(canvas, bubble, root.dataset.frame).then((avatar) => {
    if (!avatar) return;
    let toastTimer: number | undefined;

    const announce = (text: string) => {
      toast.textContent = text;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('show'), 3800);
    };

    // Las gafas de sol del premio final: se quedan puestas en las visitas siguientes, salvo que se las quite.
    const skinBtn = $<HTMLButtonElement>('avatar-skin');
    const readSkin = () => {
      try {
        return localStorage.getItem('avatar-skin') !== '0';
      } catch {
        return true;
      }
    };
    let skinOn = false;
    const setSkin = (on: boolean, remember = true) => {
      skinOn = on;
      avatar.setSkin(on);
      skinBtn.textContent = on ? g.skinOff : g.skinOn;
      if (!remember) return;
      try {
        localStorage.setItem('avatar-skin', on ? '1' : '0');
      } catch {}
    };
    setSkin(unlocked.has('completista') && readSkin(), false);
    skinBtn.addEventListener('click', () => setSkin(!skinOn));

    // Confeti (el premio de completarlo todo): papelitos que caen desde el avatar. Con «reducir movimiento», nada.
    const confetti = () => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const r = stage.getBoundingClientRect();
      const colors = ['#e8a627', '#2fbcc6', '#e05a8a', '#6d5bd0', '#f4efe6'];
      for (let i = 0; i < 46; i++) {
        const bit = document.createElement('i');
        bit.className = 'confetti';
        bit.style.left = `${r.left + r.width / 2}px`;
        bit.style.top = `${r.top + r.height * 0.3}px`;
        bit.style.background = colors[i % colors.length];
        bit.style.setProperty('--dx', `${(Math.random() - 0.5) * Math.min(innerWidth, 640)}px`);
        bit.style.setProperty('--rise', `${80 + Math.random() * 180}px`);
        bit.style.setProperty('--fall', `${innerHeight - r.top + 40}px`);
        bit.style.setProperty('--rot', `${Math.round(Math.random() * 720 - 360)}deg`);
        bit.style.animationDelay = `${Math.random() * 0.25}s`;
        document.body.append(bit);
        setTimeout(() => bit.remove(), 3200);
      }
    };

    // La planta que ya se ha regado se queda crecida (también en las visitas siguientes).
    if (unlocked.has('planta')) avatar.setGrown(true);

    /** Reacciona y, si es la primera vez, desbloquea. Devuelve si era nuevo. */
    // En la página de un proyecto: pone su marco de fotos sobre el escritorio.
    if (root.dataset.frame) {
      setTimeout(() => {
        avatar.placeFrame();
        avatar.react('marco', '', 1100);
      }, 700);
    }

    // En la 404 (`data-say` en el texto visible): mira a un lado y a otro, como perdido, y lo dice.
    const lost = document.querySelector<HTMLElement>('[data-say]:not([hidden])')?.dataset.say;
    if (lost) setTimeout(() => avatar.react('tema', lost, 4500), 900);

    // En móvil, al bajar por la página el avatar se agacha (solo asoma la cabeza) para no tapar el texto; al subir o tocarlo vuelve.
    // Para que no se agache ni se levante a saltos: hace falta desplazarse de verdad (40 px hacia abajo, 24 hacia arriba, sin
    // contar el temblor de la inercia ni de la barra del navegador) y, mientras habla, se abre el panel o acaba de tocarse,
    // se queda arriba (`lift`).
    const mobile = matchMedia('(max-width: 999px)');
    let lastY = scrollY;
    let run = 0; // lo que se lleva desplazado en la misma dirección (+ hacia abajo)
    let liftUntil = 0;
    const lift = (ms: number) => {
      root.classList.remove('tucked');
      liftUntil = Math.max(liftUntil, performance.now() + ms);
      run = 0;
    };
    addEventListener(
      'scroll',
      () => {
        const y = scrollY;
        const dy = y - lastY;
        lastY = y;
        if (!mobile.matches) return;
        run = Math.sign(dy) === Math.sign(run) ? run + dy : dy;
        if (performance.now() < liftUntil || !panel.hidden) return;
        if (run > 40 && y > 120) root.classList.add('tucked');
        else if (run < -24) root.classList.remove('tucked');
      },
      { passive: true },
    );
    stage.addEventListener('pointerdown', () => lift(6000));
    stage.addEventListener('click', () => lift(6000));
    // Todo lo que dice el avatar mantiene su bocadillo a la vista.
    for (const name of ['react', 'say'] as const) {
      const original = avatar[name] as (...args: any[]) => void;
      avatar[name] = ((...args: any[]) => {
        const text = name === 'react' ? args[1] : args[0];
        const ms = (name === 'react' ? args[2] : args[1]) ?? 3200;
        if (text) lift(ms + 800);
        original(...args);
      }) as never;
    }

    // Lo que dura cada reacción (las de varias poses necesitan más que las de un gesto).
    const DURATION: Partial<Record<AchievementId, number>> = { cafe: 4100, planta: 3800, noctambulo: 4000, lunes: 4000, completista: 4500 };
    // Los logros que llegan de golpe (al cargar la página) esperan su turno, uno tras otro.
    const queue: AchievementId[] = [];
    const later = (id: AchievementId) => {
      if (!unlocked.has(id) && !queue.includes(id)) queue.push(id);
    };
    setInterval(() => {
      if (queue.length && !document.hidden && performance.now() > busyUntil) trigger(queue.shift()!);
    }, 1000);
    let busyUntil = 0; // hasta cuándo está ocupado con una reacción (para no pisar la anterior con las de la cola)
    const trigger = (id: AchievementId, ms?: number, say?: string) => {
      ms ??= DURATION[id] ?? 3200;
      busyUntil = performance.now() + ms + 600;
      const a = g.achievements[id];
      const isNew = !unlocked.has(id);
      if (isNew) {
        unlocked.add(id);
        saveUnlocked(unlocked);
        render();
        root.classList.remove('burst');
        void root.offsetWidth;
        root.classList.add('burst');
        const n = requiredIds.filter((x) => unlocked.has(x)).length;
        const extra = BONUS_IDS.includes(id);
        announce(extra ? fmt(g.unlockedExtra, { title: a.title }) : n === total ? g.complete : fmt(g.unlocked, { title: a.title, n, total }));
        // Tener todos los demás (menos los extras) es, en sí, un logro.
        if (!extra && id !== 'completista' && n === total - 1) later('completista');
      }
      if (id === 'completista') {
        setSkin(true);
        confetti();
      }
      avatar.react(id, say ?? a.say, id === 'sueno' ? 0 : ms);
      return isNew;
    };

    // Clic: el primero es el saludo; muchos seguidos, mareo; el resto, un chiste.
    const clicks: number[] = [];
    // Las cosas del escritorio (en coordenadas del lienzo de 1024): la taza, la planta y el portátil.
    const ZONES: { id: AchievementId; x: [number, number]; y: [number, number] }[] = [
      { id: 'cafe', x: [95, 215], y: [640, 820] },
      { id: 'planta', x: [625, 730], y: [735, 860] },
      { id: 'portatil', x: [190, 500], y: [600, 830] },
    ];
    stage.addEventListener('click', (e) => {
      // Con ratón o dedo el botón no se queda con el foco: si no, la barra espaciadora (p. ej. al escribir «npm install») lo volvería a pulsar.
      if (e.detail > 0) stage.blur();
      const r = canvas.getBoundingClientRect();
      const px = ((e.clientX - r.left) / r.width) * 1024;
      const py = ((e.clientY - r.top) / r.height) * 1024;
      const zone = e.detail > 0 && ZONES.find((z) => px >= z.x[0] && px <= z.x[1] && py >= z.y[0] && py <= z.y[1]);
      if (zone) {
        clicks.length = 0;
        trigger(zone.id);
        return;
      }
      const now = performance.now();
      clicks.push(now);
      while (clicks.length && now - clicks[0] > 2500) clicks.shift();
      if (clicks.length >= 5) {
        clicks.length = 0;
        trigger('mareo');
      } else if (!unlocked.has('hola')) trigger('hola');
      else avatar.react('asiente', g.jokes[Math.floor(Math.random() * g.jokes.length)], 2600);
    });

    // Arrastrar palabras hasta el avatar.
    enableWordDrag({
      target: () => stage,
      onOver: (over) => root.classList.toggle('over', over),
      onDrop: (word) => {
        const w = WORDS[word];
        if (!w) return;
        if (w.achievement) trigger(w.achievement);
        else avatar.react('asiente', g.words[word] ?? '', 3000);
      },
    });

    // Visitar la web en los tres idiomas (se recuerdan los que ya se han visto).
    const seen = (key: string, add?: string) => {
      let list: string[] = [];
      try {
        list = JSON.parse(localStorage.getItem(key) ?? '[]');
      } catch {}
      if (add && !list.includes(add)) {
        list.push(add);
        try {
          localStorage.setItem(key, JSON.stringify(list));
        } catch {}
      }
      return list;
    };
    if (!unlocked.has('poliglota')) {
      if (seen('avatar-langs', document.documentElement.lang).length >= 3) setTimeout(() => trigger('poliglota', 4000), 2500);
    }
    // Abrir la página de cada proyecto.
    const slugs = (root.dataset.slugs ?? '').split(',').filter(Boolean);
    if (root.dataset.frame && !unlocked.has('curioso')) {
      const visited = seen('avatar-projects', root.dataset.frame);
      if (slugs.length && slugs.every((s) => visited.includes(s))) setTimeout(() => trigger('curioso', 4000), 2500);
    }
    // Quien ya tenía todos los obligatorios menos «completista» (por faltarle los extras) lo recibe ahora.
    if (!unlocked.has('completista') && requiredIds.every((x) => x === 'completista' || unlocked.has(x))) setTimeout(() => later('completista'), 4500);
    // Entrar de madrugada (hora local).
    if (!unlocked.has('noctambulo') && new Date().getHours() < 6) setTimeout(() => trigger('noctambulo', 4500), 4000);

    // Escribir un comando o un saludo con el teclado (fuera de los campos de texto).
    let keys = '';
    addEventListener('keydown', (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey || e.key.length !== 1) return;
      if ((e.target as Element).closest('input, textarea, select, [contenteditable]')) return;
      keys = (keys + e.key.toLowerCase()).slice(-20);
      const secret = Object.keys(SECRETS).find((s) => keys.endsWith(s));
      if (secret) {
        keys = '';
        trigger(SECRETS[secret], 3600);
        return;
      }
      for (const cmd of Object.keys(g.commands)) {
        if (keys.endsWith(cmd)) {
          keys = '';
          trigger('terminal', 3200, g.commands[cmd]);
          return;
        }
      }
      // Un saludo solo cuenta si es una palabra entera («hola», no «ahola»).
      const hello = g.hellos.find((h) => keys.endsWith(h) && !/[\p{L}]/u.test(keys.charAt(keys.length - h.length - 1)));
      if (hello) {
        keys = '';
        trigger('charla');
      }
    });

    // Quedarse quieto: se duerme; al volver a moverte, se despierta.
    let lastActive = performance.now();
    let asleep = false;
    let yawned = false;
    const active = () => {
      lastActive = performance.now();
      yawned = false;
      if (asleep) {
        asleep = false;
        avatar.stop();
        avatar.say(g.woke, 2200);
      }
    };
    for (const ev of ['pointermove', 'pointerdown', 'keydown', 'scroll', 'touchstart'])
      addEventListener(ev, active, { passive: true });
    setInterval(() => {
      if (asleep || document.hidden) return;
      const idle = performance.now() - lastActive;
      if (idle > 25000) {
        asleep = true;
        trigger('sueno');
      } else if (idle > 16000 && !yawned) {
        // Antes de dormirse, bosteza (sin logro ni mensaje: es solo un gesto).
        yawned = true;
        avatar.react('bostezo', '', 3400);
      }
    }, 2000);

    // Llegar al final de la página (habiendo bajado de verdad).
    addEventListener(
      'scroll',
      () => {
        const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
        if (atBottom && scrollY > 200 && !unlocked.has('final')) trigger('final', 4500);
      },
      { passive: true },
    );

    // Cambiar de tema varias veces seguidas.
    const themeTaps: number[] = [];
    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.theme, .theme-group button')) return;
      const now = performance.now();
      themeTaps.push(now);
      while (themeTaps.length && now - themeTaps[0] > 8000) themeTaps.shift();
      if (themeTaps.length >= 4 && !unlocked.has('tema')) trigger('tema');
    });

    // Agitar el móvil (en iOS el navegador pide permiso: se pide con el primer toque al avatar).
    const touchDevice = mobileDevice;
    let lastShake = 0;
    let shakes = 0;
    let [lx, ly, lz] = [0, 0, 0];
    const onMotion = (e: DeviceMotionEvent) => {
      const a = e.accelerationIncludingGravity;
      if (!a || a.x == null || a.y == null || a.z == null) return;
      const delta = Math.abs(a.x - lx) + Math.abs(a.y - ly) + Math.abs(a.z - lz);
      [lx, ly, lz] = [a.x, a.y, a.z];
      const now = performance.now();
      if (delta < 25 || now - lastShake < 120) return;
      shakes = now - lastShake > 900 ? 1 : shakes + 1;
      lastShake = now;
      if (shakes >= 4) {
        shakes = 0;
        trigger('agitar');
      }
    };
    if (touchDevice && typeof DeviceMotionEvent !== 'undefined') {
      const ask = (DeviceMotionEvent as unknown as { requestPermission?: () => Promise<string> }).requestPermission;
      if (typeof ask !== 'function') addEventListener('devicemotion', onMotion);
      else
        stage.addEventListener(
          'click',
          () => {
            ask.call(DeviceMotionEvent)
              .then((r) => r === 'granted' && addEventListener('devicemotion', onMotion))
              .catch(() => {});
          },
          { once: true },
        );
    }

    // Código clásico con el teclado.
    const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let typed = 0;
    addEventListener('keydown', (e) => {
      const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
      typed = k === code[typed] ? typed + 1 : k === code[0] ? 1 : 0;
      if (typed === code.length) {
        typed = 0;
        trigger('konami');
      }
    });

    // Logros anotados fuera de la portada (el CV impreso, un enlace que sacó al visitante de la web).
    for (const id of takePending()) later(id);
    const mark = (id: AchievementId) => {
      if (unlocked.has(id)) return;
      addPending(id);
      // Si la página sigue ahí (enlace en otra pestaña), se concede ya; si no, será al volver.
      setTimeout(() => {
        for (const p of takePending()) later(p);
      }, 900);
    };

    // Copiar el correo.
    document.addEventListener('copy', () => {
      if ((getSelection()?.toString() ?? '').includes('@')) later('buzon');
    });
    // Pegar texto en la web.
    document.addEventListener('paste', () => later('pegar'));
    // Seguir un enlace externo.
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href]');
      if (a && /^https?:/.test(a.href) && new URL(a.href).origin !== location.origin) mark('explorador');
    });

    // Volver otro día.
    if (!unlocked.has('habitual')) {
      const today = new Date().toDateString();
      if (seen('avatar-days', today).length >= 2) setTimeout(() => later('habitual'), 5000);
    }
    // Entrar un lunes, un viernes por la tarde o a la hora de comer (hora local).
    const now = new Date();
    const [day, hour] = [now.getDay(), now.getHours()];
    if (day === 1) setTimeout(() => later('lunes'), 6000);
    if (day === 5 && hour >= 15) setTimeout(() => later('viernes'), 6000);
    if (hour === 14) setTimeout(() => later('comida'), 6000);

    // Leer la experiencia con calma: la sección a la vista y sin mover nada (antes de que bostece).
    const exp = document.getElementById('experiencia');
    let expVisible = false;
    if (exp && !unlocked.has('lector'))
      new IntersectionObserver(([en]) => (expVisible = en.intersectionRatio > 0.4), { threshold: [0, 0.4] }).observe(exp);
    setInterval(() => {
      if (expVisible && !asleep && !document.hidden && !unlocked.has('lector') && performance.now() - lastActive > 14000) later('lector');
    }, 2000);

    // Subir y bajar la página sin parar: cambios de sentido con trecho recorrido, varios en pocos segundos.
    const flips: number[] = [];
    let dir = 0;
    let peak = scrollY; // hasta dónde ha llegado en el sentido actual
    addEventListener(
      'scroll',
      () => {
        const y = scrollY;
        if (!dir) {
          if (Math.abs(y - peak) > 120) {
            dir = Math.sign(y - peak);
            peak = y;
          }
          return;
        }
        if ((y - peak) * dir > 0) peak = y;
        else if (Math.abs(y - peak) > 120) {
          dir = -dir;
          peak = y;
          const t = performance.now();
          flips.push(t);
          while (flips.length && t - flips[0] > 6000) flips.shift();
          if (flips.length >= 5) {
            flips.length = 0;
            later('rebote');
          }
        }
      },
      { passive: true },
    );

    // Zoom (Ctrl +, Ctrl y rueda, o pellizco en el móvil) y cambios de tamaño de la ventana.
    const zooms: number[] = [];
    const zoomed = () => {
      const t = performance.now();
      zooms.push(t);
      while (zooms.length && t - zooms[0] > 6000) zooms.shift();
      if (zooms.length >= 4) {
        zooms.length = 0;
        later('zoom');
      }
    };
    addEventListener('wheel', (e) => e.ctrlKey && zoomed(), { passive: true });
    addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && ['+', '=', '-', '_'].includes(e.key)) zoomed();
      // Ver el código fuente / abrir las herramientas de desarrollo.
      const k = e.key.toLowerCase();
      if ((e.ctrlKey || e.metaKey) && !e.shiftKey && k === 'u') later('codigo');
      if (e.key === 'F12' || ((e.ctrlKey || e.metaKey) && e.shiftKey && ['i', 'j', 'c'].includes(k)) || (e.metaKey && e.altKey && ['i', 'j', 'c'].includes(k)))
        later('detective');
    });
    if (visualViewport) visualViewport.addEventListener('resize', () => visualViewport!.scale > 1.6 && later('zoom'));
    const widths: number[] = [];
    let w0 = innerWidth;
    let wdir = 0;
    addEventListener('resize', () => {
      // Con las herramientas de desarrollo ancladas, la ventana por fuera es bastante mayor que por dentro.
      if (!touchDevice && (outerWidth - innerWidth > 200 || outerHeight - innerHeight > 260)) later('detective');
      const d = Math.sign(innerWidth - w0);
      if (!d || Math.abs(innerWidth - w0) < 80) return;
      w0 = innerWidth;
      if (wdir && d !== wdir) {
        const t = performance.now();
        widths.push(t);
        while (widths.length && t - widths[0] > 8000) widths.shift();
        if (widths.length >= 3) {
          widths.length = 0;
          later('responsive');
        }
      }
      wdir = d;
    });

    // Llegar hasta el avatar con el tabulador.
    stage.addEventListener('focus', () => stage.matches(':focus-visible') && later('tab'));

    // Panel: lista de interacciones; las ya descubiertas se pueden repetir.
    // Sube desde el avatar: si la pantalla es baja, el panel se limita al hueco que hay arriba y se desplaza por dentro.
    const fitPanel = () => {
      if (panel.hidden) return;
      // Quitar el tope un momento hace que el panel crezca y el navegador reinicie su desplazamiento: se recuerda y se restituye.
      const top = panel.scrollTop;
      panel.style.maxHeight = '';
      panel.style.maxHeight = `${Math.max(120, Math.floor(panel.getBoundingClientRect().bottom - 12))}px`;
      panel.scrollTop = top;
    };
    addEventListener('resize', fitPanel);
    const setPanel = (open: boolean) => {
      panel.hidden = !open;
      counter.setAttribute('aria-expanded', String(open));
      if (open) {
        lift(0);
        bubble.classList.remove('show'); // el panel sube por el mismo sitio que el bocadillo
      }
      fitPanel();
    };
    counter.addEventListener('click', (e) => {
      e.stopPropagation();
      setPanel(panel.hidden === true);
    });
    panel.addEventListener('click', (e) => {
      const li = (e.target as Element).closest<HTMLElement>('li');
      if (li && (e.target as Element).closest('.try')) trigger(li.dataset.id as AchievementId);
      if (li && (e.target as Element).closest('.hint')) {
        const id = li.dataset.id!;
        hints[id] = Math.min(2, (hints[id] ?? 0) + 1);
        saveHints(hints);
        render();
        fitPanel();
      }
    });
    addEventListener('click', (e) => {
      if (!panel.hidden && !root.contains(e.target as Node)) setPanel(false);
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setPanel(false);
        counter.focus();
      }
    });
  }));
</script>

