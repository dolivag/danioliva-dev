---
---
<div class="avatar" data-state="hero" aria-hidden="true">
  <div class="bubble" id="avatar-bubble"></div>
  <canvas id="avatar-canvas" width="1024" height="1024"></canvas>
</div>

<script>
  import { startAvatar } from '../scripts/avatar';

  const canvas = document.getElementById('avatar-canvas') as HTMLCanvasElement | null;
  const bubble = document.getElementById('avatar-bubble');
  if (canvas && bubble) startAvatar(canvas, bubble);
</script>

<style>
  /* La ilustración ocupa el lienzo cuadrado entero (sin fondo): el escritorio flota sobre la página. */
  .avatar {
    --size: 132px;
    --ease: cubic-bezier(0.3, 0.8, 0.2, 1);
    position: fixed;
    z-index: 20;
    width: var(--size);
    height: var(--size);
    right: 12px;
    bottom: 6px;
    cursor: pointer;
    opacity: 0;
    transition:
      width 0.7s var(--ease),
      height 0.7s var(--ease),
      right 0.7s var(--ease),
      bottom 0.7s var(--ease),
      opacity 0.6s ease 0.8s,
      translate 1.1s var(--ease) 0.8s;
  }
  .avatar:global(.ready) {
    opacity: 1;
  }
  /* Entra subiendo desde abajo, justo después del nombre. */
  @media (prefers-reduced-motion: no-preference) {
    .avatar {
      translate: 0 80px;
    }
    .avatar:global(.ready) {
      translate: 0 0;
    }
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 10px 18px rgba(20, 17, 31, 0.18));
  }

  /* Portada: grande, junto al titular. */
  .avatar[data-state='hero'] {
    --size: clamp(280px, 40vw, 440px);
    right: max(0px, calc((100vw - 760px) / 2 - 60px));
    bottom: calc(50vh - var(--size) / 2 - 20px);
  }

  .bubble {
    position: absolute;
    z-index: 1; /* el lienzo lleva `filter` y, si no, tapa la burbuja */
    right: 62%;
    bottom: 78%;
    transform: translateY(6px);
    max-width: 220px;
    width: max-content;
    background: var(--accent);
    color: var(--on-accent);
    font: 600 13px/1.3 var(--sans);
    padding: 8px 12px;
    border-radius: 12px 12px 4px 12px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .bubble:global(.show) {
    opacity: 1;
    transform: none;
  }
  .avatar[data-state='hero'] .bubble {
    font-size: 15px;
    right: auto;
    left: 68%;
    bottom: 84%;
    border-radius: 12px 12px 12px 4px;
  }

  /* Pantallas grandes: grande y fijo a la derecha en todas las secciones (no se encoge a la esquina). */
  @media (min-width: 1000px) {
    .avatar,
    .avatar[data-state] {
      --size: clamp(400px, min(46vw, 82vh), 680px);
      right: max(0px, calc((100vw - 1180px) / 2 - 24px));
      bottom: calc(50vh - var(--size) / 2);
    }
    /* En la portada, más pequeño y pegado abajo: el nombre gigante se lee entero encima. */
    .avatar[data-state='hero'] {
      --size: clamp(340px, min(36vw, 62vh), 540px);
      bottom: 0;
    }
    .bubble {
      right: auto;
      left: 4%;
      bottom: 78%;
      font-size: 15px;
      border-radius: 12px 12px 12px 4px;
    }
    /* En la portada va a la izquierda de él, bajo la cinta, para no tapar el nombre. */
    .avatar[data-state='hero'] .bubble {
      left: auto;
      right: 96%;
      bottom: 24%;
      border-radius: 12px 12px 4px 12px;
    }
  }

  @media (max-width: 999px) {
    .avatar {
      --size: 150px;
      right: 2px;
      bottom: 2px;
    }
    .avatar[data-state='hero'] {
      --size: min(300px, 78vw);
      right: calc(50vw - var(--size) / 2);
      /* justo debajo de la cinta (la cabecera y el nombre miden más o menos 64 px + 55 vw) */
      bottom: calc(100svh - 64px - 55vw - var(--size));
    }
    .avatar[data-state='hero'] .bubble {
      left: auto;
      right: 30%;
      border-radius: 12px 12px 4px 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .avatar,
    .bubble {
      transition: none;
    }
  }
</style>
