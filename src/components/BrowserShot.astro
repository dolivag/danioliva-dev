---
import type { Shot } from '../data/site';

interface Props {
  shot: Shot;
  /** En su página: la captura entera, sin asomar por abajo de la tarjeta. */
  full?: boolean;
  /** Dirección que se enseña en la barra del navegador. */
  host: string;
}
const { shot, host, full = false } = Astro.props;
---
<div class:list={['browser', { full, 'has-clip': !!shot.clip }]}>
  <div class="bar" aria-hidden="true">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="url">{host}</span>
  </div>
  <div class="shot-screen screen">
    {
      shot.clip ? (
        <video class="clip" data-clip muted loop playsinline preload="none" width="960" height="600" poster={`${shot.clip}.jpg`} role="img" aria-label={shot.clipAlt ?? shot.alt}>
          <source src={`${shot.clip}.webm`} type="video/webm" />
          <source src={`${shot.clip}.mp4`} type="video/mp4" />
        </video>
      ) : (
        <>
          <img class="light" src={shot.src} alt={shot.alt} width="1440" height="900" loading="lazy" decoding="async" />
          {shot.srcDark && <img class="dark" src={shot.srcDark} alt="" width="1440" height="900" loading="lazy" decoding="async" />}
        </>
      )
    }
  </div>
</div>

<script>
  // Vídeos en bucle: solo corren mientras se ven (ahorra batería y datos). Con «reducir movimiento»
  // no arrancan solos: se enseña el póster y el vídeo con controles.
  const clips = document.querySelectorAll<HTMLVideoElement>('video[data-clip]');
  if (clips.length) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      clips.forEach((v) => {
        v.controls = true;
        v.loop = false;
      });
    } else {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => (e.isIntersecting ? (e.target as HTMLVideoElement).play().catch(() => {}) : (e.target as HTMLVideoElement).pause())),
        { threshold: 0.35 },
      );
      clips.forEach((v) => io.observe(v));
    }
  }
</script>

<style>
  /* Ventana de navegador que asoma por abajo de la tarjeta; al pasar el cursor sube un poco. */
  .browser {
    --rise: 0px;
    position: relative;
    margin: 26px 0 -28px;
    border-radius: 12px 12px 0 0;
    background: #14161b;
    box-shadow:
      0 0 0 1px rgba(128, 128, 128, 0.28),
      0 18px 40px rgba(0, 0, 0, 0.3);
    translate: 0 var(--rise);
    transition: translate 0.7s var(--ease, cubic-bezier(0.19, 1, 0.22, 1));
    pointer-events: none;
  }
  :global(.proj:hover) .browser {
    --rise: -10px;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 9px 12px;
    background: #1c1f26;
    border-radius: 12px 12px 0 0;
  }
  .dots {
    display: inline-flex;
    gap: 6px;
  }
  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
  }
  .url {
    flex: 1;
    max-width: 300px;
    margin: 0 auto;
    padding: 3px 12px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.6);
    font: 400 11px/1.4 var(--font);
    letter-spacing: 0.02em;
    text-align: center;
  }
  .screen {
    position: relative;
    width: 100%;
    aspect-ratio: 12 / 5;
    overflow: hidden;
  }
  .clip {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    background: #14161b;
  }
  /* Con vídeo, la ventana se enseña entera (16:10), también en la tarjeta. */
  .has-clip .screen {
    aspect-ratio: 16 / 10;
  }
  .full {
    margin: 0;
    border-radius: 12px;
    translate: none;
  }
  .full .bar {
    border-radius: 12px 12px 0 0;
  }
  .full .screen {
    aspect-ratio: 16 / 10;
    border-radius: 0 0 12px 12px;
  }
  :global(.proj:hover) .full {
    --rise: 0px;
  }
  @media (max-width: 699px) {
    .screen {
      aspect-ratio: 4 / 3;
    }
    .full .screen {
      aspect-ratio: 16 / 10;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .browser {
      transition: none;
    }
  }
</style>
