---
import type { Shot } from '../data/site';

interface Props {
  shots: Shot[];
}
const shots = Astro.props.shots.slice(0, 3);
---
<div class={`phones n${shots.length}`} aria-hidden={shots.length ? undefined : 'true'}>
  {
    shots.map((s, i) => (
      <figure class="phone phone-frame" style={`--i:${i}`}>
        <div class="shot-screen">
          {s.clip ? (
            <video class="clip light" data-clip muted loop playsinline preload="none" width="390" height="844" data-poster={`${s.clip}.jpg`} aria-label={s.alt}>
              <source src={`${s.clip}.mp4`} type="video/mp4" />
              <source src={`${s.clip}.webm`} type="video/webm" />
            </video>
          ) : (
            <img class="light" src={s.src} alt={s.alt} width="390" height="844" loading="lazy" decoding="async" />
          )}
          {s.clipDark ? (
            <video class="clip dark" data-clip muted loop playsinline preload="none" width="390" height="844" data-poster={`${s.clipDark}.jpg`} aria-hidden="true">
              <source src={`${s.clipDark}.mp4`} type="video/mp4" />
              <source src={`${s.clipDark}.webm`} type="video/webm" />
            </video>
          ) : (
            s.srcDark && <img class="dark" src={s.srcDark} alt="" width="390" height="844" loading="lazy" decoding="async" />
          )}
        </div>
      </figure>
    ))
  }
</div>

<script>
  import '../scripts/clips';
</script>

<style>
  /* Los móviles asoman por abajo a la derecha de la tarjeta; al pasar el cursor suben y se abren. */
  .phones {
    position: absolute;
    right: 26px;
    bottom: 0;
    width: 330px;
    height: 100%;
    pointer-events: none;
  }
  .phone {
    --w: 150px;
    --rise: 0px;
    position: absolute;
    bottom: -70px;
    width: var(--w);
    transition:
      translate 0.7s var(--ease, cubic-bezier(0.19, 1, 0.22, 1)),
      rotate 0.7s var(--ease, cubic-bezier(0.19, 1, 0.22, 1));
    translate: 0 var(--rise);
  }
  /* Una, dos o tres capturas: abanico centrado a la derecha */
  .n1 .phone { right: 80px; }
  .n2 .phone:nth-child(1) { right: 118px; rotate: -4deg; --rise: 14px; }
  .n2 .phone:nth-child(2) { right: 10px; rotate: 3deg; }
  .n3 .phone:nth-child(1) { right: 174px; rotate: -6deg; --rise: 26px; --w: 128px; }
  .n3 .phone:nth-child(2) { right: 86px; rotate: 0deg; z-index: 1; }
  .n3 .phone:nth-child(3) { right: -2px; rotate: 6deg; --rise: 26px; --w: 128px; }

  :global(.proj:hover) .phone {
    --rise: -26px;
  }
  :global(.proj:hover) .n2 .phone:nth-child(1) { rotate: -7deg; }
  :global(.proj:hover) .n2 .phone:nth-child(2) { rotate: 6deg; }
  :global(.proj:hover) .n3 .phone:nth-child(1) { rotate: -10deg; }
  :global(.proj:hover) .n3 .phone:nth-child(3) { rotate: 10deg; }

  @media (max-width: 699px) {
    .phones {
      position: relative;
      right: auto;
      width: 100%;
      height: 230px;
      margin-top: 22px;
    }
    .phone { --w: 120px; bottom: -60px; }
    .n1 .phone { right: calc(50% - 60px); }
    .n2 .phone:nth-child(1) { right: calc(50% - 8px); }
    .n2 .phone:nth-child(2) { right: calc(50% - 124px); }
    .n3 .phone { --w: 104px; }
    .n3 .phone:nth-child(1) { right: calc(50% + 6px); }
    .n3 .phone:nth-child(2) { right: calc(50% - 52px); }
    .n3 .phone:nth-child(3) { right: calc(50% - 110px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .phone { transition: none; }
  }
</style>
