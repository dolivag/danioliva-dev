---
---
<canvas id="pixel-bg" aria-hidden="true"></canvas>

<script>
  // Fondo de mosaico de píxeles. Los cuadros de debajo del cursor se encienden y se apagan solos.
  const canvas = document.getElementById('pixel-bg') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let tile = 48;
    let cols = 0;
    let rows = 0;
    let base = new Uint8Array(0); // tono de cada cuadro (0, 1, 2)
    let heat = new Float32Array(0);
    let raf = 0;
    const colors = { a: '', b: '', c: '', glow: '' };

    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      colors.a = s.getPropertyValue('--tile-a').trim();
      colors.b = s.getPropertyValue('--tile-b').trim();
      colors.c = s.getPropertyValue('--tile-c').trim();
      colors.glow = s.getPropertyValue('--glow').trim();
    };

    // Aleatorio con semilla: el mosaico es siempre el mismo.
    const rng = (seed: number) => () => {
      seed = (seed + 0x6d2b79f5) >>> 0;
      let t = seed;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };

    const draw = () => {
      const tones = [colors.a, colors.b, colors.c];
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const i = y * cols + x;
          ctx.fillStyle = tones[base[i]];
          ctx.fillRect(x * tile, y * tile, tile, tile);
          if (heat[i] > 0.02) {
            ctx.fillStyle = `rgba(${colors.glow}, ${heat[i] * 0.55})`;
            ctx.fillRect(x * tile, y * tile, tile, tile);
          }
        }
      }
    };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      tile = innerWidth < 700 ? 36 : 48;
      cols = Math.ceil(innerWidth / tile);
      rows = Math.ceil(innerHeight / tile);
      canvas.width = cols * tile;
      canvas.height = rows * tile;
      canvas.style.width = `${cols * tile}px`;
      canvas.style.height = `${rows * tile}px`;
      void dpr;
      const r = rng(11);
      base = new Uint8Array(cols * rows).map(() => Math.floor(r() * 3));
      heat = new Float32Array(cols * rows);
      readColors();
      draw();
    };

    const loop = () => {
      let any = false;
      for (let i = 0; i < heat.length; i++) {
        if (heat[i] > 0) {
          heat[i] *= 0.93;
          if (heat[i] < 0.02) heat[i] = 0;
          else any = true;
        }
      }
      draw();
      raf = any ? requestAnimationFrame(loop) : 0;
    };

    if (!reduced) {
      addEventListener(
        'pointermove',
        (e) => {
          const cx = Math.floor(e.clientX / tile);
          const cy = Math.floor(e.clientY / tile);
          for (let dy = -1; dy <= 1; dy++) {
            for (let dx = -1; dx <= 1; dx++) {
              const x = cx + dx;
              const y = cy + dy;
              if (x < 0 || y < 0 || x >= cols || y >= rows) continue;
              const k = 1 - 0.35 * (Math.abs(dx) + Math.abs(dy));
              const i = y * cols + x;
              heat[i] = Math.max(heat[i], k);
            }
          }
          if (!raf) raf = requestAnimationFrame(loop);
        },
        { passive: true },
      );
    }
    addEventListener('resize', resize);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      readColors();
      draw();
    });
    resize();
  }
</script>

<style>
  canvas {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
</style>
