---
import type { Shot } from '../data/site';

interface Props {
  shots: Shot[];
}
const { shots } = Astro.props;
---
<div class="gallery">
  {
    shots.map((s) => (
      <figure class="phone-frame">
        <div class="shot-screen">
          {s.clip ? (
            <video class="clip light" data-clip muted loop playsinline preload="none" width="390" height="844" poster={`${s.clip}.jpg`} role="img" aria-label={s.alt}>
              <source src={`${s.clip}.mp4`} type="video/mp4" />
              <source src={`${s.clip}.webm`} type="video/webm" />
            </video>
          ) : (
            <img class="light" src={s.src} alt={s.alt} width="390" height="844" loading="lazy" decoding="async" />
          )}
          {s.clipDark ? (
            <video class="clip dark" data-clip muted loop playsinline preload="none" width="390" height="844" poster={`${s.clipDark}.jpg`} aria-hidden="true">
              <source src={`${s.clipDark}.mp4`} type="video/mp4" />
              <source src={`${s.clipDark}.webm`} type="video/webm" />
            </video>
          ) : (
            s.srcDark && <img class="dark" src={s.srcDark} alt="" width="390" height="844" loading="lazy" decoding="async" />
          )}
        </div>
      </figure>
    ))
  }
</div>

<script>
  import '../scripts/clips';
</script>
