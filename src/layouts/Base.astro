---
import '../styles/global.css';
import { site } from '../data/site';
import { useDict, langFromPath, stripLang, localePath, locales, ogLocale, defaultLang } from '../i18n';
import type { Lang } from '../i18n';
import Avatar from '../components/Avatar.astro';
import LangSwitch from '../components/LangSwitch.astro';
import Glow from '../components/Glow.astro';
import Micro from '../components/Micro.astro';

interface Props {
  /** Idioma de la página (por defecto, el de su ruta). */
  lang?: Lang;
  title?: string;
  description?: string;
  /** Proyecto del que el avatar cuelga un marco (su página). */
  frame?: string;
  /** Tarjeta para compartir: `home` o el `slug` de un proyecto (`public/og/<idioma>/<og>.png`). */
  og?: string;
  /** Datos estructurados (schema.org) de la página. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, frame, og = 'home', jsonLd } = Astro.props;
const lang: Lang = Astro.props.lang ?? langFromPath(Astro.url.pathname);
const t = useDict(lang);
const description = Astro.props.description ?? t.meta.description;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${t.role}`;
const path = stripLang(Astro.url.pathname);
const abs = (l: Lang) => new URL(localePath(l, path), Astro.site).href;
// Sube la versión al regenerar las tarjetas: WhatsApp y otros guardan la imagen de cada enlace y así la vuelven a pedir.
const OG_VERSION = 2;
const ogImage = `${new URL(`/og/${lang}/${og}.png`, Astro.site).href}?v=${OG_VERSION}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Tema elegido antes (si lo hay): se aplica antes de pintar para que no haya parpadeo.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales.filter((l) => l !== lang).map((l) => (<meta property="og:locale:alternate" content={ogLocale[l]} />))}
    {locales.map((l) => (<link rel="alternate" hreflang={l} href={abs(l)} />))}
    <link rel="alternate" hreflang="x-default" href={abs(defaultLang)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3f1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    {jsonLd && (<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />)}
    <link rel="canonical" href={abs(lang)} />
  </head>
  <body>
    <Glow />
    <Micro />
    <div class="progress" aria-hidden="true"></div>
    <div class="wrap">
      <header class="top">
        <a class="brand" href={localePath(lang, '/')} aria-label={site.name}>&lt;D<span>.</span>O/&gt;</a>
        <nav class="pill" aria-label={t.nav.label}>
          <a href={localePath(lang, '/')}>{t.nav.index}</a>
          <a href={localePath(lang, '/#proyectos')}>{t.nav.projects}</a>
          <a href={localePath(lang, '/#experiencia')}>{t.nav.experience}</a>
          <a href={localePath(lang, '/#contacto')}>{t.nav.contact}</a>
          <LangSwitch lang={lang} path={path} variant="pill" />
          <button class="theme" type="button" aria-label={t.theme.toggle} title={t.theme.toggleTitle}>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></svg>
          </button>
        </nav>
        <div class="social">
          <LangSwitch lang={lang} path={path} variant="header" />
          <a href={site.github}>GitHub</a>
          <a href={site.linkedin}>LinkedIn</a>
          <a href={`mailto:${site.email}`}>{t.common.email}</a>
        </div>
      </header>
      <main><slot /></main>
      <footer>
        © {new Date().getFullYear()} {site.name} ·{' '}
        <a href={site.github}>GitHub</a> ·{' '}
        <a href={site.linkedin}>LinkedIn</a> ·{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </footer>
    </div>
    <div class="theme-group" role="group" aria-label={t.theme.group}>
      <button type="button" data-mode="light" aria-pressed="false" aria-label={t.theme.light} title={t.theme.lightShort}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></svg>
      </button>
      <button type="button" data-mode="dark" aria-pressed="false" aria-label={t.theme.dark} title={t.theme.darkShort}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" /></svg>
      </button>
      <button type="button" data-mode="system" aria-pressed="false" aria-label={t.theme.system} title={t.theme.systemShort}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
      </button>
    </div>
    <Avatar lang={lang} frame={frame} />

    <script>
      const root = document.documentElement;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. El nombre gigante: cada línea en una máscara y cada letra en su propio trozo, para que
      //    suban desde abajo una detrás de otra.
      document.querySelectorAll<HTMLElement>('[data-fit]').forEach((group) => {
        group.querySelectorAll<HTMLElement>('.line').forEach((line, row) => {
          const text = line.textContent ?? '';
          line.setAttribute('aria-label', text);
          line.innerHTML = Array.from(text)
            .map((ch, i) => `<span class="letter" aria-hidden="true" style="--r:${row};--i:${i}">${ch === ' ' ? '&nbsp;' : ch}</span>`)
            .join('');
          const mask = document.createElement('span');
          mask.className = 'row';
          line.replaceWith(mask);
          mask.append(line);
        });
      });

      // 2. Los títulos de sección: también suben desde una máscara.
      document.querySelectorAll<HTMLElement>('section > h2').forEach((h2) => {
        h2.innerHTML = `<span class="mask"><span class="inner">${h2.innerHTML}</span></span>`;
      });

      // 3. El nombre llena el ancho de la pantalla: se ajusta el tamaño a la línea más larga.
      const fit = () => {
        document.querySelectorAll<HTMLElement>('[data-fit]').forEach((group) => {
          const lines = Array.from(group.querySelectorAll<HTMLElement>('.line'));
          const available = group.clientWidth;
          let widest = 1;
          for (const line of lines) {
            line.style.fontSize = '100px';
            line.style.display = 'inline-block';
            widest = Math.max(widest, line.getBoundingClientRect().width);
            line.style.display = '';
          }
          const size = (100 * available) / widest;
          for (const line of lines) line.style.fontSize = `${Math.floor(size * 10) / 10}px`;
        });
      };
      fit();
      addEventListener('resize', fit);

      // 2b. Tema: «claro», «oscuro» o «sistema» (por defecto). Lo elegido se guarda en el navegador.
      // (Las dos metas `theme-color` —claro y oscuro— se ponen del color elegido, que puede no ser el del sistema.)
      const themeColors = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
      const resolved = () =>
        root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const mode = () => root.dataset.theme ?? 'system';
      const applyTheme = () => {
        const dark = resolved() === 'dark';
        themeColors.forEach((m) => m.setAttribute('content', dark ? '#0f1115' : '#f3f1ec'));
        document
          .querySelectorAll<HTMLElement>('.theme-group [data-mode]')
          .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode())));
        document.querySelector('.theme')?.setAttribute('aria-pressed', String(dark));
        dispatchEvent(new Event('themechange'));
      };
      const setMode = (next: string) => {
        if (next === 'system') {
          delete root.dataset.theme;
        } else {
          root.dataset.theme = next;
        }
        try {
          if (next === 'system') localStorage.removeItem('theme');
          else localStorage.setItem('theme', next);
        } catch {}
        applyTheme();
      };
      document.querySelectorAll<HTMLElement>('.theme-group [data-mode]').forEach((b) => {
        b.addEventListener('click', () => setMode(b.dataset.mode ?? 'system'));
      });
      // Móvil: un solo botón dentro de la píldora que alterna claro / oscuro.
      document
        .querySelector('.theme')
        ?.addEventListener('click', () => setMode(resolved() === 'dark' ? 'light' : 'dark'));
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', applyTheme);
      applyTheme();

      // 3b. Pasada la portada, la píldora del menú crece y se vuelve de cristal.
      const pill = document.querySelector<HTMLElement>('nav.pill');
      const hero = document.querySelector<HTMLElement>('.hero');
      let limit = 80;
      let ticking = false;
      const measure = () => {
        limit = hero ? hero.offsetTop + hero.offsetHeight - 140 : 80;
      };
      const mark = () => {
        pill?.classList.toggle('scrolled', scrollY > limit);
        ticking = false;
      };
      measure();
      mark();
      addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(mark);
          }
        },
        { passive: true },
      );
      addEventListener('resize', () => {
        measure();
        mark();
      });

      // 4. Entrada: cuando la tipografía está lista arranca el nombre y, justo después, el resto de
      //    elementos van apareciendo escalonados (los de más abajo, al llegar a ellos con el scroll).
      const REVEAL =
        'header.top > *, .marquee, .hero .role, .intro > *, .proj, .entry, .fact, .contact-link, ul.links li, section > h2, footer';
      let started = false;
      const start = () => {
        if (started) return;
        started = true;
        fit();
        requestAnimationFrame(() => {
          root.classList.add('ready');
          if (reduced) return;
          let first = true;
          const io = new IntersectionObserver(
            (entries) => {
              const visible = entries.filter((e) => e.isIntersecting);
              visible.forEach((e, i) => {
                (e.target as HTMLElement).style.transitionDelay = `${(first ? 0.75 : 0) + i * 0.09}s`;
                e.target.classList.add('in');
                io.unobserve(e.target);
              });
              if (visible.length) first = false;
            },
            { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
          );
          document.querySelectorAll(REVEAL).forEach((el) => io.observe(el));
        });
      };
      if (reduced) root.classList.add('ready');
      (document.fonts?.ready ?? Promise.resolve()).then(start);
      setTimeout(start, 2500); // por si la tipografía tarda
    </script>
  </body>
</html>
