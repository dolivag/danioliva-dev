---
import '../styles/global.css';
import { site } from '../data/site';
import Avatar from '../components/Avatar.astro';
import PixelBg from '../components/PixelBg.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'Software engineer fullstack. Aplicaciones y herramientas pequeñas.' } =
  Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Tema elegido antes (si lo hay): se aplica antes de pintar para que no haya parpadeo.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#b7bb82" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <PixelBg />
    <div class="wrap">
      <header class="top">
        <a class="brand" href="/" aria-label={site.name}>&lt;D<span>.</span>O/&gt;</a>
        <nav class="pill" aria-label="Principal">
          <a href="/">Índice</a>
          <a href="/#proyectos">Proyectos</a>
          <a href="/#experiencia">Experiencia</a>
          <a href="/#contacto">Contacto</a>
          <button class="theme" type="button" aria-label="Cambiar entre tema claro y oscuro" title="Tema claro / oscuro">
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></svg>
          </button>
        </nav>
        <div class="social">
          <a href={site.github}>GitHub</a>
          <a href={`mailto:${site.email}`}>Email</a>
        </div>
      </header>
      <main><slot /></main>
      <footer>
        © {new Date().getFullYear()} {site.name} ·{' '}
        <a href={site.github}>GitHub</a> ·{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </footer>
    </div>
    <div class="theme-group" role="group" aria-label="Tema de la web">
      <button type="button" data-mode="light" aria-pressed="false" aria-label="Tema claro" title="Claro">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></svg>
      </button>
      <button type="button" data-mode="dark" aria-pressed="false" aria-label="Tema oscuro" title="Oscuro">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" /></svg>
      </button>
      <button type="button" data-mode="system" aria-pressed="false" aria-label="Tema del sistema" title="Sistema">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
      </button>
    </div>
    <Avatar />

    <script>
      const root = document.documentElement;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. El nombre gigante: cada línea en una máscara y cada letra en su propio trozo, para que
      //    suban desde abajo una detrás de otra.
      document.querySelectorAll<HTMLElement>('[data-fit]').forEach((group) => {
        group.querySelectorAll<HTMLElement>('.line').forEach((line, row) => {
          const text = line.textContent ?? '';
          line.setAttribute('aria-label', text);
          line.innerHTML = Array.from(text)
            .map((ch, i) => `<span class="letter" aria-hidden="true" style="--r:${row};--i:${i}">${ch}</span>`)
            .join('');
          const mask = document.createElement('span');
          mask.className = 'row';
          line.replaceWith(mask);
          mask.append(line);
        });
      });

      // 2. Los títulos de sección: también suben desde una máscara.
      document.querySelectorAll<HTMLElement>('section > h2').forEach((h2) => {
        h2.innerHTML = `<span class="mask"><span class="inner">${h2.innerHTML}</span></span>`;
      });

      // 3. El nombre llena el ancho de la pantalla: se ajusta el tamaño a la línea más larga.
      const fit = () => {
        document.querySelectorAll<HTMLElement>('[data-fit]').forEach((group) => {
          const lines = Array.from(group.querySelectorAll<HTMLElement>('.line'));
          const available = group.clientWidth;
          let widest = 1;
          for (const line of lines) {
            line.style.fontSize = '100px';
            line.style.display = 'inline-block';
            widest = Math.max(widest, line.getBoundingClientRect().width);
            line.style.display = '';
          }
          const size = (100 * available) / widest;
          for (const line of lines) line.style.fontSize = `${Math.floor(size * 10) / 10}px`;
        });
      };
      fit();
      addEventListener('resize', fit);

      // 2b. Tema: «claro», «oscuro» o «sistema» (por defecto). Lo elegido se guarda en el navegador.
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      const resolved = () =>
        root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const mode = () => root.dataset.theme ?? 'system';
      const applyTheme = () => {
        const dark = resolved() === 'dark';
        themeColor?.setAttribute('content', dark ? '#1f2312' : '#b7bb82');
        document
          .querySelectorAll<HTMLElement>('.theme-group [data-mode]')
          .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode())));
        document.querySelector('.theme')?.setAttribute('aria-pressed', String(dark));
        dispatchEvent(new Event('themechange'));
      };
      const setMode = (next: string) => {
        if (next === 'system') {
          delete root.dataset.theme;
        } else {
          root.dataset.theme = next;
        }
        try {
          if (next === 'system') localStorage.removeItem('theme');
          else localStorage.setItem('theme', next);
        } catch {}
        applyTheme();
      };
      document.querySelectorAll<HTMLElement>('.theme-group [data-mode]').forEach((b) => {
        b.addEventListener('click', () => setMode(b.dataset.mode ?? 'system'));
      });
      // Móvil: un solo botón dentro de la píldora que alterna claro / oscuro.
      document
        .querySelector('.theme')
        ?.addEventListener('click', () => setMode(resolved() === 'dark' ? 'light' : 'dark'));
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', applyTheme);
      applyTheme();

      // 3b. Pasada la portada, la píldora del menú crece y se vuelve de cristal.
      const pill = document.querySelector<HTMLElement>('nav.pill');
      const hero = document.querySelector<HTMLElement>('.hero');
      let limit = 80;
      let ticking = false;
      const measure = () => {
        limit = hero ? hero.offsetTop + hero.offsetHeight - 140 : 80;
      };
      const mark = () => {
        pill?.classList.toggle('scrolled', scrollY > limit);
        ticking = false;
      };
      measure();
      mark();
      addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(mark);
          }
        },
        { passive: true },
      );
      addEventListener('resize', () => {
        measure();
        mark();
      });

      // 4. Entrada: cuando la tipografía está lista arranca el nombre y, justo después, el resto de
      //    elementos van apareciendo escalonados (los de más abajo, al llegar a ellos con el scroll).
      const REVEAL =
        'header.top > *, .marquee, .intro > *, .proj, .entry, .fact, .contact-link, ul.links li, section > h2, footer';
      let started = false;
      const start = () => {
        if (started) return;
        started = true;
        fit();
        requestAnimationFrame(() => {
          root.classList.add('ready');
          if (reduced) return;
          let first = true;
          const io = new IntersectionObserver(
            (entries) => {
              const visible = entries.filter((e) => e.isIntersecting);
              visible.forEach((e, i) => {
                (e.target as HTMLElement).style.transitionDelay = `${(first ? 0.75 : 0) + i * 0.09}s`;
                e.target.classList.add('in');
                io.unobserve(e.target);
              });
              if (visible.length) first = false;
            },
            { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
          );
          document.querySelectorAll(REVEAL).forEach((el) => io.observe(el));
        });
      };
      if (reduced) root.classList.add('ready');
      (document.fonts?.ready ?? Promise.resolve()).then(start);
      setTimeout(start, 2500); // por si la tipografía tarda
    </script>
  </body>
</html>
