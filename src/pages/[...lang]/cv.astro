---
import '../../styles/global.css';
import { site } from '../../data/site';
import { cv } from '../../i18n/cv';
import { locales, defaultLang, langNames, localePath, ogLocale } from '../../i18n';
import type { Lang } from '../../i18n';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l === defaultLang ? undefined : l }, props: { lang: l } }));
}

const { lang } = Astro.props as { lang: Lang };
const c = cv[lang];
const abs = (l: Lang) => new URL(localePath(l, '/cv/'), Astro.site).href;
const title = `${site.name} · ${c.title}`;
const linkedinText = site.linkedin.replace('https://www.linkedin.com/in/', '').replace(/\/$/, '');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={c.description} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={c.description} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales.map((l) => (<link rel="alternate" hreflang={l} href={abs(l)} />))}
    <link rel="alternate" hreflang="x-default" href={abs(defaultLang)} />
    <link rel="canonical" href={abs(lang)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="cv-page">
    <div class="cv-bar">
      <a href={localePath(lang, '/')}>← {c.ui.back}</a>
      <nav aria-label={c.ui.langs}>
        {locales.map((l) => (<a href={localePath(l, '/cv/')} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>{langNames[l]}</a>))}
      </nav>
      <button type="button" id="cv-print">{c.ui.print}</button>
    </div>

    <main class="sheet">
      <aside class="side">
        <img class="photo" src="/cv/foto.webp" width="280" height="368" alt={c.ui.photoAlt} />

        <section>
          <h2>{c.contact.title}</h2>
          <dl class="contact">
            <dt>{c.contact.email}</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
            <dt>{c.contact.linkedin}</dt>
            <dd><a href={site.linkedin}>/{linkedinText}</a></dd>
            <dt>{c.contact.github}</dt>
            <dd><a href={site.github}>/dolivag</a></dd>
          </dl>
        </section>

        <section>
          <h2>{c.skills.title}</h2>
          {c.skills.groups.map((g) => (
            <div class="group">
              <h3>{g.title}</h3>
              <ul>{g.items.map((i) => (<li>{i}</li>))}</ul>
            </div>
          ))}
        </section>

        <section>
          <h2>{c.soft.title}</h2>
          <ul>{c.soft.items.map((i) => (<li>{i}</li>))}</ul>
        </section>

        <section>
          <h2>{c.languages.title}</h2>
          <ul class="langs">{c.languages.items.map((l) => (<li><b>{l.name}</b> · {l.level}</li>))}</ul>
        </section>
      </aside>

      <div class="main">
        <header>
          <h1>Daniel<br />Oliva Gómez</h1>
          <p class="role">{c.role}</p>
        </header>

        <section>
          <h2>{c.about.title}</h2>
          <p>{c.about.text}</p>
        </section>

        <section>
          <h2>{c.experience.title}</h2>
          {c.experience.jobs.map((j) => (
            <article class="job">
              <div class="head">
                <h3>{j.role} <span>/</span> {j.company}</h3>
                <p class="meta">{j.place} · {j.period}</p>
              </div>
              <ul>{j.bullets.map((b) => (<li>{b}</li>))}</ul>
            </article>
          ))}
        </section>

        <section>
          <h2>{c.education.title}</h2>
          {c.education.items.map((e) => (
            <article class="job">
              <div class="head">
                <h3>{e.school}</h3>
                <p class="meta">{e.period}</p>
              </div>
              <p class="lines">{e.lines.join(' · ')}</p>
            </article>
          ))}
        </section>

        <section>
          <h2>{c.additional.title}</h2>
          {c.additional.paragraphs.map((p) => (<p>{p}</p>))}
        </section>
      </div>
    </main>

    <script>
      document.getElementById('cv-print')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>

<style is:global>
  /* El currículum es siempre «papel» claro con la barra lateral grafito, también si la web está en oscuro. */
  .cv-page {
    --paper: #f7f5f0;
    --ink: #14161b;
    --muted: #4b4f58;
    --side: #14161b;
    --side-ink: #ece9e2;
    --side-muted: #b3b6be;
    --amber: #e8a627;
    --amber-ink: #8a5a00;
    margin: 0;
    padding: 0 0 48px;
    background: #d9d6cf;
    color: var(--ink);
    font-family: 'Inter Variable', system-ui, sans-serif;
  }
  /* global.css da relleno y tamaños a `section` y `h2`: aquí no. */
  .cv-page section { padding: 0; scroll-margin: 0; }
  .cv-page h2, .cv-page h3 { text-transform: none; }
  .cv-bar {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px;
    max-width: 210mm; margin: 0 auto; padding: 18px 12px; font-size: 13px;
  }
  .cv-bar a { color: var(--ink); text-underline-offset: 3px; }
  .cv-bar nav { display: flex; gap: 14px; }
  .cv-bar nav a[aria-current] { font-weight: 700; text-decoration: none; }
  .cv-bar button {
    appearance: none; border: 0; border-radius: 999px; padding: 10px 18px; background: var(--ink); color: var(--paper);
    font: 600 12px/1 'Inter Variable', system-ui, sans-serif; letter-spacing: 0.06em; text-transform: uppercase; cursor: pointer;
  }
  .cv-bar button:hover { background: var(--amber-ink); }

  .sheet {
    display: grid; grid-template-columns: 72mm 1fr; width: 210mm; min-height: 297mm; margin: 0 auto;
    background: var(--paper); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25); font-size: 9pt; line-height: 1.4;
  }
  .side { background: var(--side); color: var(--side-ink); padding: 12mm 8mm; }
  .side a { color: var(--side-ink); text-decoration: none; word-break: break-all; }
  .photo { display: block; width: 100%; height: auto; border-radius: 3mm; filter: grayscale(1); }
  .side h2 {
    margin: 8mm 0 3mm; font: 600 7.5pt/1 'Inter Variable', system-ui, sans-serif; letter-spacing: 0.16em; text-transform: uppercase; color: var(--amber);
  }
  .side section:first-of-type h2 { margin-top: 9mm; }
  .side h3 { margin: 0 0 1mm; font: 600 9pt/1.3 'Inter Variable', system-ui, sans-serif; }
  .side .group { margin-bottom: 2.5mm; }
  .side ul { margin: 0; padding: 0; list-style: none; color: var(--side-muted); }
  .side li { position: relative; padding-left: 3.4mm; margin-bottom: 1mm; }
  .side li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 1.4mm; height: 1.4mm; border-radius: 50%; background: var(--amber); }
  .side .langs b { color: var(--side-ink); font-weight: 600; }
  .contact { margin: 0; }
  .contact dt { margin-top: 2mm; font-size: 7pt; letter-spacing: 0.12em; text-transform: uppercase; color: var(--side-muted); }
  .contact dd { margin: 0.4mm 0 0; }

  .main { padding: 10mm 11mm 8mm 10mm; }
  .main header { margin-bottom: 6mm; padding-bottom: 4.5mm; border-bottom: 0.6mm solid var(--amber); }
  .main h1 { margin: 0; font: 400 33pt/1 'Fraunces Variable', Georgia, serif; letter-spacing: -0.02em; }
  .main .role { margin: 3.5mm 0 0; font: 600 8.5pt/1 'Inter Variable', system-ui, sans-serif; letter-spacing: 0.16em; text-transform: uppercase; color: var(--amber-ink); }
  .main h2 {
    margin: 5mm 0 2.2mm; font: 400 16pt/1 'Fraunces Variable', Georgia, serif; letter-spacing: -0.01em;
  }
  .main h2::after { content: '.'; color: var(--amber); }
  .main section:first-of-type h2 { margin-top: 0; }
  .main p { margin: 0 0 2mm; color: var(--muted); }
  .job { margin-bottom: 4mm; break-inside: avoid; }
  .job .head h3 { margin: 0; font: 500 11.5pt/1.2 'Fraunces Variable', Georgia, serif; }
  .job .head h3 span { color: var(--amber-ink); }
  .job .meta { margin: 0.6mm 0 1.6mm; font-size: 7.8pt; letter-spacing: 0.04em; color: var(--amber-ink); }
  .job ul { margin: 0; padding-left: 4mm; color: var(--muted); }
  .job li { margin-bottom: 1mm; }
  .job .lines { margin: 0; }

  @media screen and (max-width: 220mm) {
    .sheet { width: auto; min-height: 0; grid-template-columns: 1fr; font-size: 15px; }
    .side { padding: 24px 20px; }
    .photo { max-width: 220px; }
    .main { padding: 24px 20px; }
    .main h1 { font-size: 40px; }
    .main h2 { font-size: 24px; }
    .side h2 { font-size: 11px; }
    .job .head h3 { font-size: 18px; }
    .job .meta { font-size: 12px; }
    .contact dt { font-size: 10px; }
    .cv-bar { padding: 14px 16px; }
  }

  @page { size: A4; margin: 0; }
  @media print {
    .cv-page { background: none; padding: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .cv-bar { display: none; }
    .sheet { width: 210mm; min-height: 297mm; box-shadow: none; margin: 0; }
  }
</style>
