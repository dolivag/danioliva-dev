---
import Base from '../layouts/Base.astro';
import { site, marquee, projects, experience, studies } from '../data/site';

const pad = (n: number) => String(n + 1).padStart(2, '0');
const items = [...marquee, ...marquee];
---
<Base>
  <div class="hero" data-avatar="hero">
    <h1 data-fit>
      <span class="line l1">Daniel</span>
      <span class="line l2">Oliva</span>
    </h1>
    <div class="marquee" aria-hidden="true">
      <div class="track">
        {[0, 1].map(() => (
          <span>
            {marquee.map((m) => (<><span>{m}</span><b>+</b></>))}
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="col intro" data-avatar="hero">
    <span class="label">D.<em>/</em> {site.role}</span>
    <p class="big">
      Graduado en 2024 y fullstack engineer en Zennio. Me gusta construir aplicaciones y
      herramientas pequeñas que hacen el día a día un poco más fácil.
    </p>
    <p>
      Trabajo con Angular, Node.js, NestJS, React y React Native, y me encargo también de
      herramientas de automatización y CI/CD. Fuera del trabajo construyo mis propios proyectos.
    </p>
    <div class="actions">
      <a class="btn" href="#proyectos">Ver proyectos</a>
      <a class="btn secondary" href="#contacto">Contacto</a>
    </div>
  </div>

  <section class="col" id="proyectos" data-avatar="projects">
    <h2>Proyectos</h2>
    {projects.map((p, i) => {
      const Tag = p.href ? 'a' : 'div';
      return (
        <Tag
          class="proj"
          href={p.href || undefined}
          target={p.href?.startsWith('http') ? '_blank' : undefined}
          rel={p.href?.startsWith('http') ? 'noopener' : undefined}
        >
          <div class="meta">
            {(p.stack ? p.stack.split(' · ') : ['Proyecto personal']).map((t) => (<span>{t}</span>))}
            {p.href && <span class="plus">+</span>}
          </div>
          <div class="name"><sup>{pad(i)}</sup>{p.name}{p.status && <span class="status">{p.status}</span>}</div>
          <p>{p.description}</p>
        </Tag>
      );
    })}
  </section>

  <section class="col" id="experiencia" data-avatar="experience">
    <h2>Experiencia</h2>
    {experience.map((e) => (
      <div class="entry">
        <span class="when">{e.period}</span>
        <h3>{e.role} <span>/</span> {e.company}</h3>
        <p>{e.description}</p>
      </div>
    ))}
  </section>

  <section class="col" id="estudios" data-avatar="studies">
    <h2>Estudios</h2>
    {studies.map((s) => (
      <div class="entry">
        <span class="when">{s.title.match(/\((.*?)\)/)?.[1] ?? ''}</span>
        <h3>{s.school}</h3>
        <p>{s.title.replace(/\s*\(.*?\)/, '')}</p>
      </div>
    ))}
  </section>

  <section class="col" id="contacto" data-avatar="contact">
    <h2>Contacto</h2>
    <a class="contact-link" href={`mailto:${site.email}`}><small>Escríbeme</small>{site.email}</a>
    <a class="contact-link" href={site.github}><small>Código</small>GitHub / dolivag</a>
  </section>
</Base>
