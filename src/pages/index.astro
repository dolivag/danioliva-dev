---
import Base from '../layouts/Base.astro';
import { site, marquee, projects, projectUrl, experience, studies } from '../data/site';
import { WORDS } from '../scripts/game';
import PhoneShots from '../components/PhoneShots.astro';
import BrowserShot from '../components/BrowserShot.astro';

const pad = (n: number) => String(n + 1).padStart(2, '0');
const items = [...marquee, ...marquee];
---
<Base>
  <div class="hero home" data-avatar="hero">
    <h1 data-fit>
      <span class="hi">Hi, I'm</span>
      <span class="line l1">{site.name}</span>
    </h1>
    <p class="role">Software engineer</p>
    <div class="marquee" aria-hidden="true">
      <div class="track">
        {[0, 1].map(() => (
          <span>
            {marquee.map((m) => (<><span>{m}</span><b>+</b></>))}
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="col intro" data-avatar="hero">
    <p class="big">
      Graduado en 2024 y fullstack engineer en Zennio. Me gusta construir aplicaciones y
      herramientas pequeñas que hacen el día a día un poco más fácil.
    </p>
    <p>
      Trabajo con Angular, Node.js, NestJS, React y React Native, y me encargo también de
      herramientas de automatización y CI/CD. Fuera del trabajo construyo mis propios proyectos.
    </p>
    <div class="actions">
      <a class="btn" href="#proyectos">Ver proyectos</a>
      <a class="btn secondary" href="#contacto">Contacto</a>
    </div>
  </div>

  <section class="col" id="proyectos" data-avatar="projects">
    <h2>Proyectos</h2>
    {projects.map((p, i) => (
      <article class:list={['proj', { 'has-shots': p.shots?.length, 'has-web': p.web }]}>
        <div class="meta">
          {(p.stack ? p.stack.split(' · ') : ['Proyecto personal']).map((t) => (<span data-drag={t.toLowerCase() in WORDS ? t.toLowerCase() : undefined}>{t}</span>))}
          {p.href && (
            <a class="open" href={p.href} target="_blank" rel="noopener" aria-label={`Abrir ${p.name} en una pestaña nueva`}>↗</a>
          )}
        </div>
        <div class="name"><sup>{pad(i)}</sup><a class="stretch" href={projectUrl(p)}><span class="word" data-drag={p.name.toLowerCase()}>{p.name}</span></a>{p.status && <span class="status">{p.status}</span>}</div>
        <p>{p.description}</p>
        {p.shots?.length ? <PhoneShots shots={p.shots} /> : null}
        {p.web && p.href ? <BrowserShot shot={p.web} host={new URL(p.href).host} /> : null}
      </article>
    ))}
  </section>

  <section class="col" id="experiencia" data-avatar="experience">
    <h2>Experiencia</h2>
    {experience.map((e) => (
      <div class="entry">
        <span class="when">{e.period}</span>
        <h3>{e.role} <span>/</span> {e.company}</h3>
        <p>{e.description}</p>
        {e.bullets && (
          <details class="more">
            <summary>Ver el detalle</summary>
            <ul>{e.bullets.map((b) => (<li>{b}</li>))}</ul>
          </details>
        )}
      </div>
    ))}
  </section>

  <section class="col" id="estudios" data-avatar="studies">
    <h2>Estudios</h2>
    {studies.map((s) => (
      <div class="entry">
        <span class="when">{s.title.match(/\((.*?)\)/)?.[1] ?? ''}</span>
        <h3>{s.school}</h3>
        <p>{s.title.replace(/\s*\(.*?\)/, '')}</p>
      </div>
    ))}
  </section>

  <section class="col" id="contacto" data-avatar="contact">
    <h2>Contacto</h2>
    <a class="contact-link" href={`mailto:${site.email}`}><small>Escríbeme</small>{site.email}</a>
    <a class="contact-link" href={site.github}><small>Código</small>GitHub / dolivag</a>
  </section>
</Base>
